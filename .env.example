# Lighthouse configuration.
# Copy to `.env` (docker compose reads it automatically) and adjust.

# ---- bind address & public identity -----------------------------------------
# Interface the server binds to *inside* the container. Keep 0.0.0.0 so the
# Docker port mapping works.
LIGHTHOUSE_HOST=0.0.0.0
# Container port; keep in sync with the compose port mapping.
LIGHTHOUSE_PORT=8080
# Host (and optional :port) users see, e.g. registry.example.com.
PUBLIC_HOST=localhost:8080
# Scheme clients use. Use https in production.
PUBLIC_SCHEME=http
# Absolute base URL used in e-mails and redirects. Must match
# PUBLIC_SCHEME://PUBLIC_HOST when you are not on localhost.
BASE_URL=http://localhost:8080

# ---- storage ----------------------------------------------------------------
# Paths *inside* the container. docker-compose bind-mounts ./database, ./data
# and ./logs onto these; changing them means editing the compose volumes too.
DATABASE_DIR=/app/database
DATABASE_URL=sqlite:///app/database/lighthouse.db?mode=rwc
DATA_DIR=/app/data
LOGS_DIR=/app/logs
# Directory containing the built frontend (already baked into the image).
FRONTEND_DIR=/app/dist

# ---- authentication ---------------------------------------------------------
# REQUIRED. Token signing key. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL_SECS=3600
REFRESH_TOKEN_TTL_SECS=2592000
EMAIL_VERIFICATION_TTL_SECS=86400
PASSWORD_RESET_TTL_SECS=3600
UPLOAD_SESSION_TTL_SECS=86400
# Registry bearer tokens handed to `docker pull`/`docker login`, and the
# short-lived token issued between the password and two-factor steps.
REGISTRY_TOKEN_TTL_SECS=300
MFA_TOKEN_TTL_SECS=300
# Lifetime of a registry refresh token — the `identitytoken` `docker login`
# stores and reuses for the life of the login.
REGISTRY_REFRESH_TOKEN_TTL_SECS=2592000
# WWW-Authenticate scheme advertised on 401: bearer (default), basic or both.
# Basic credentials are always accepted server-side regardless of this value.
REGISTRY_AUTH_CHALLENGE=bearer
COOKIE_NAME=lighthouse_token
# Leave blank to scope the cookie to the request host.
COOKIE_DOMAIN=
# true (default) requires HTTPS; set false only for plain-HTTP local use.
COOKIE_SECURE=true
# Trust X-Forwarded-For / X-Real-IP from a reverse proxy. Keep true behind Caddy.
TRUST_PROXY=true
# Comma-separated IPs/CIDRs allowed to set forwarded headers. Empty trusts any
# peer; when set, a peer outside the list fails closed.
TRUSTED_PROXY_CIDRS=
REGISTRATION_ENABLED=true

# ---- transactional e-mail (Brevo) -------------------------------------------
# When false, e-mail is not delivered: rendered messages, including the
# verification link, are written to ./logs instead.
EMAIL_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Lighthouse Registry

# ---- abuse protection -------------------------------------------------------
CAPTCHA_ENABLED=false
CAPTCHA_DIFFICULTY=18
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=20

# ---- misc -------------------------------------------------------------------
# Maximum accepted blob size in bytes. Leave blank for unlimited.
MAX_BLOB_SIZE=
# ---- layer browser cache ----------------------------------------------------
# Estimated byte budget for cached layer filesystem indices (LRU-evicted).
LAYER_CACHE_MAX_BYTES=67108864
# Seconds a cached layer index is served before it is rebuilt.
LAYER_CACHE_TTL_SECS=900
# Maximum decompressed bytes scanned per layer-browser request.
LAYER_MAX_SCAN_BYTES=4294967296
# Maximum tar entries inspected per layer-browser request.
LAYER_MAX_ENTRIES=100000
LIBRAVATAR_BASE_URL=https://seccdn.libravatar.org
LIGHTHOUSE_TITLE=Lighthouse
# tracing filter, e.g. info, debug, or "lighthouse=debug,tower_http=info".
RUST_LOG=info
